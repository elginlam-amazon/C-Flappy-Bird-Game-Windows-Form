<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Flappy_Bird_Windows_Form</RootNamespace>
    <AssemblyName>Flappy Bird Windows Form</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Allows building/restoring the Windows-only target on non-Windows build agents (CI/containers). No effect on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- Assembly metadata migrated from the former Properties/AssemblyInfo.cs -->
    <AssemblyTitle>Flappy Bird Windows Form</AssemblyTitle>
    <Product>Flappy Bird Windows Form</Product>
    <Copyright>Copyright ©  2020</Copyright>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Version>1.0.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.InteropServices.ComVisibleAttribute">
      <_Parameter1>false</_Parameter1>
      <_Parameter1_IsLiteral>true</_Parameter1_IsLiteral>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.InteropServices.GuidAttribute">
      <_Parameter1>050c9abb-a0d1-4404-a4b3-1620ae98f8cd</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
